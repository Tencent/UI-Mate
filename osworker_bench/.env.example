# OSWorker mock apps (required for endpoint synchronization)
# The mock stack is deployed separately; see README.md.
MOCK_APP_BASE_URL=http://replace-with-mock-host

# Optional outbound proxy. Leave unset for direct network access.
# HTTP_PROXY=http://proxy-host:3128
# HTTPS_PROXY=http://proxy-host:3128
# OSWORLD_PROXY_HOST=proxy-host
# OSWORLD_PROXY_PORT=3128
# NO_PROXY=localhost,127.0.0.1,replace-with-mock-host

# Optional Hugging Face settings. vLLM downloads tencent/UI-Mate-27B by default.
# HF_TOKEN=
# HF_HOME=/path/to/huggingface-cache
# HF_REVISION=b6753bc357a756301f3429a95b38362da6035030

# Pin this to an immutable digest for reproducible Docker runs.
# OSWORLD_DOCKER_IMAGE=happysixd/osworld-docker@sha256:<digest>

# OpenAI-compatible model endpoint used when invoking the Python runner directly.
OPENAI_BASE_URL=http://127.0.0.1:8081/v1
OPENAI_API_KEY=dummy

# Optional OSWorld server port.
OSWORLD_PORT=5000
