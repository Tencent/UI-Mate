        "files": [
          {
            "url": "https://huggingface.co/datasets/faker-w/ubuntu_osworld_file_cache/resolve/main/multi_apps/b2d9c649-7e4a-49a3-bc2e-000000b2d9/b2d9report-thunderbird-profile.tar.gz",
            "path": "/home/user/b2d9report-thunderbird-profile.tar.gz"
