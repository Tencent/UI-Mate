            "path": "/home/user/Desktop/to_send/mail_info.xlsx"
          },
          {
            "url": "https://huggingface.co/datasets/faker-w/ubuntu_osworld_file_cache/resolve/main/multi_apps/c0ndpdf0-eea1-49a3-bc2e-c0ndbr020001/weekly_summary.pptx",
